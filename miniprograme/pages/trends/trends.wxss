/* pages/trends/trends.wxss */
.bars { display: flex; align-items: flex-end; gap: 4rpx; height: 180rpx; margin-top: 16rpx; }
.bar { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; min-width: 0; }
.bar-fill {
  width: 100%; max-width: 24rpx; border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: linear-gradient(180deg, #4b9fe1, #7ed8b5);
}
.bar.is-miss .bar-fill { background: #e3e8ef; }
.bar-lb { font-size: 16rpx; color: var(--c-minor); margin-top: 6rpx; white-space: nowrap; }
.bar-legend { display: flex; gap: 24rpx; font-size: 22rpx; color: var(--c-sub); margin-top: 16rpx; flex-wrap: wrap; }
.bar-legend .lg { display: flex; align-items: center; gap: 8rpx; }
.lg-dot { width: 18rpx; height: 18rpx; border-radius: 4rpx; }

.weight-summary { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 12rpx; }
.ws-num { font-size: 48rpx; font-weight: 800; }
.ws-num.is-down { color: var(--fui-color-success); }
.ws-num.is-up { color: var(--fui-color-danger); }
.ws-lb { font-size: 24rpx; color: var(--c-minor); }
