<import src="../../templates/common.wxml"/><view class="page"><template is="header" data="{{title:'回看记录，读懂变化',error,loading,busy,pending}}"/><view class="trend-tabs"><button data-section="trends" bindtap="onSection">趋势</button><button data-section="records" bindtap="onSection">记录</button></view><block wx:if="{{section === 'trends'}}"><view class="row"><button data-metric="weight_kg" bindtap="onMetric">体重</button><button data-metric="sleep_minutes" bindtap="onMetric">睡眠</button><button data-metric="exercise_minutes" bindtap="onMetric">运动</button></view><view class="card"><view class="subtitle">{{metricLabel}}</view><view class="muted">最近28天 · 已记录 {{recordedDays}} 天，缺失日期不算零。</view><view wx:if="{{recordedDays < 2}}">记录至少两个日期后显示趋势。</view><view wx:else class="trend"><view wx:for="{{bars}}" wx:key="date" class="trend-column"><view class="trend-track"><view wx:if="{{item.known}}" class="trend-bar" style="height:{{item.height}}%;"/></view><view class="trend-date">{{item.dateLabel}}</view></view></view><native-fold title="逐日数值"><view wx:for="{{points}}" wx:key="date" class="field">{{item.date}}：{{item.text}}</view></native-fold></view></block><block wx:else><view class="card"><picker mode="date" value="{{activeDate}}" bindchange="onDate"><view>{{activeDate || '选择日期'}} ▾</view></picker><view class="muted">{{records.length}} 条记录</view></view><native-event wx:for="{{records}}" wx:key="id" event="{{item}}" highlight="{{item.id === selected}}"/><view wx:if="{{!records.length}}" class="card">这一天还没有记录，试试其他日期。</view><native-fold wx:if="{{months.length}}" title="月度摘要"><view wx:for="{{months}}" wx:key="month" class="card"><view class="subtitle">{{item.month}} 月度摘要</view><view>{{item.data.record_count}} 条记录 · {{item.data.meal_count}} 餐 · 平均体重 {{item.weightText}} kg</view><view class="muted">逐日明细已归档，不能还原。</view><view wx:if="{{item.data.memory.status !== 'valid'}}" class="muted">请核对摘要依据。</view></view></native-fold></block><template is="footer" data="{{busy,loading}}"/></view>
