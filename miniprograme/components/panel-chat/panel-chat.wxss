/* components/panel-chat/panel-chat.wxss */
.chat-panel { position: relative; display: flex; flex-direction: column; overflow: hidden; height: 100%; }

.chat-mode {
  flex: none; display: flex; align-items: center; gap: 16rpx; padding: 8rpx 24rpx;
}
.chat-mode-tag {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 22rpx; color: #0a8f5f; font-weight: 600;
  background: rgba(9,190,79,.12); border: 1px solid rgba(9,190,79,.2);
  padding: 6rpx 18rpx; border-radius: var(--qj-r-pill);
}
.chat-mode-tag.is-local { color: var(--c-sub); background: rgba(120,120,128,.1); border-color: var(--hairline); }
.chat-mode-tag .dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; }
.chat-bell { margin-left: auto; position: relative; padding: 8rpx; }
.chat-badge {
  position: absolute; top: 0; right: -4rpx; min-width: 30rpx; height: 30rpx;
  border-radius: 15rpx; background: var(--fui-color-danger); color: #fff;
  font-size: 18rpx; line-height: 30rpx; text-align: center; padding: 0 8rpx;
}

.chat-offline, .chat-pending {
  display: flex; align-items: center; gap: 10rpx; flex: none;
  margin: 8rpx 24rpx 0; padding: 16rpx 20rpx; border-radius: var(--qj-r-lg);
  font-size: 22rpx; line-height: 1.5;
}
.chat-offline { background: rgba(255,107,138,.08); border: 1px solid rgba(255,107,138,.2); color: #b04257; }
.chat-pending { background: rgba(232,163,61,.1); border: 1px solid rgba(232,163,61,.28); color: #8f6420; }
.chat-pending-tx { flex: 1; }

.chat-scroll { flex: 1; min-height: 0; width: 100%; padding: 12rpx 24rpx 0; box-sizing: border-box; }

.msg-row { display: flex; gap: 16rpx; margin-bottom: 28rpx; align-items: flex-start; }
.msg-row.is-user { flex-direction: row-reverse; }
.avatar-bot {
  width: 64rpx; height: 64rpx; border-radius: 20rpx; flex: none; display: block;
  border: 1px solid rgba(255,255,255,.6);
  box-shadow: 0 6rpx 16rpx rgba(75,159,225,.28);
}
.msg-col { max-width: 78%; display: flex; flex-direction: column; gap: 8rpx; }
.msg-row.is-user .msg-col { align-items: flex-end; }

.bub {
  padding: 22rpx 28rpx; font-size: 28rpx; line-height: 1.65; border-radius: 28rpx;
  word-break: break-word; white-space: pre-wrap;
}
.bub-user {
  background: linear-gradient(135deg, var(--fui-color-primary), #2f7fc4);
  color: #fff; border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(1,82,147,.22);
}
.bub-bot {
  background: var(--glass-card-bg); border: 1px solid var(--glass-border);
  border-bottom-left-radius: 8rpx; box-shadow: var(--glass-ring); color: var(--c-text);
}
.msg-time { font-size: 20rpx; color: var(--c-minor); padding: 0 8rpx; }

.msg-saved {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 22rpx; color: #0a8f5f; padding: 8rpx 16rpx;
  background: rgba(9,190,79,.08); border-radius: var(--qj-r-pill);
}

.msg-trace { font-size: 22rpx; }
.trace-hd { display: flex; align-items: center; gap: 6rpx; color: var(--c-minor); padding: 4rpx 8rpx; }
.trace-bd {
  margin-top: 8rpx; padding: 16rpx; background: rgba(255,255,255,.4);
  border-radius: var(--qj-r-md); border: 1px solid var(--glass-border);
}
.trace-step { display: flex; gap: 12rpx; padding: 8rpx 0; }
.trace-dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex: none; margin-top: 10rpx; }
.trace-dot.is-model { background: var(--fui-color-purple); }
.trace-dot.is-local { background: var(--fui-color-primary); }
.trace-tx { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }
.trace-tt { font-size: 22rpx; color: var(--c-sub); font-weight: 600; }
.trace-dt { font-size: 20rpx; color: var(--c-minor); line-height: 1.5; }

.typing { display: flex; gap: 8rpx; align-items: center; padding: 26rpx 28rpx; }
.typing .tdot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #b9c4d2; animation: tp 1.1s infinite; }
.typing .tdot:nth-child(2) { animation-delay: .18s; }
.typing .tdot:nth-child(3) { animation-delay: .36s; }
@keyframes tp { 0%,60%,100% { transform: translateY(0); opacity: .5; } 30% { transform: translateY(-8rpx); opacity: 1; } }

.chat-quick { flex: none; white-space: nowrap; padding: 12rpx 24rpx; }
.chat-quick .qj-chips { display: inline-flex; }
.chat-quick .qj-chip { gap: 8rpx; }

.chat-input { flex: none; padding: 8rpx 24rpx 12rpx; }
.ci-box {
  display: flex; align-items: center; gap: 12rpx;
  background: rgba(255,255,255,.85);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--glass-border); border-radius: var(--qj-r-pill);
  padding: 10rpx 12rpx 10rpx 28rpx; box-shadow: 0 8rpx 24rpx rgba(15,23,42,.1);
}
.ci-field { flex: 1; font-size: 28rpx; color: var(--c-text); min-height: 48rpx; }
.ci-send {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex: none;
  background: linear-gradient(135deg, var(--fui-color-primary), #2f7fc4);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(1,82,147,.3); transition: .15s;
}
.ci-send.is-disabled { opacity: .4; box-shadow: none; }
.ci-send:active { transform: scale(.92); }

/* 麦克风键：长按/按住触发语音输入 */
.ci-mic {
  width: 56rpx; height: 56rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: rgba(120,120,128,.08); transition: .15s;
}
.ci-mic.is-rec { background: var(--fui-color-danger); animation: mic-pulse 1.2s infinite; }
@keyframes mic-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,107,138,.35); }
  50% { box-shadow: 0 0 0 10rpx rgba(255,107,138,0); }
}

/* 语音输入浮层（移植自 chengshichuxing 语音态：底部渐变幕 + 12 条波形 + 上滑取消变红） */
.voice-mask {
  position: fixed; inset: 0; z-index: 300;
  background: linear-gradient(to bottom, rgba(10, 14, 20, 0.92), rgba(24, 58, 110, 0.94));
  display: flex; align-items: flex-end; justify-content: center;
  padding-bottom: calc(100px + env(safe-area-inset-bottom));
}
.voice-panel { display: flex; flex-direction: column; align-items: center; gap: 36rpx; width: 100%; }
.voice-wave { display: flex; align-items: center; gap: 8rpx; height: 88rpx; }
.voice-bar {
  width: 6rpx; height: 20rpx; border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.85);
  animation: voice-pulse 0.9s ease-in-out infinite alternate;
}
.voice-cancel .voice-bar { background: rgba(255, 120, 120, 0.9); }
@keyframes voice-pulse { from { height: 16rpx; } to { height: 76rpx; } }
.voice-text {
  max-width: 78vw; color: #ffffff; font-size: 30rpx; font-weight: 600;
  text-align: center; line-height: 1.5;
}
.voice-hint { color: rgba(255, 255, 255, 0.65); font-size: 22rpx; }
.voice-cancel .voice-hint, .voice-cancel .voice-text { color: rgba(255, 150, 150, 0.95); }
