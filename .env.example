# Development only; hardened containers receive explicit Compose configuration.
RUNTIME_PROFILE=development
# Set to local_only to prevent all outbound model calls.
PROCESSING_MODE=model_allowed
SCHEDULER_ENABLED=true
JOB_RUNNER_ENABLED=true
JOB_POLL_SECONDS=2
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=3
JOB_CATCHUP_DAYS=7
JOB_SHUTDOWN_GRACE_SECONDS=15

# No built-in credentials. Set all three to use a real model.
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen3.8-max
# MODEL_API_KEY_FILE=C:\\private\\qingji-model-key.txt
# MODEL_API_KEY is allowed only in development and conflicts with *_FILE.

# Hardened Compose: absolute host path OUTSIDE this repository, never a real key here.
# MODEL_API_KEY_SOURCE_FILE=C:\\private\\qingji-model-key.txt
# WECHAT_APP_SECRET_SOURCE_FILE=C:\\private\\qingji-wechat-secret.txt

REQUEST_MAX_BYTES=65536
REQUEST_BODY_SECONDS=10
MODEL_RESPONSE_MAX_BYTES=1048576
RUNTIME_MAX_EXECUTIONS=2
EXECUTION_SECONDS=120
EXECUTION_GRACE_SECONDS=15

# Optional; defaults to ./data.
# DATA_DIR=C:\\path\\to\\health-data
# Metadata-only observability. No prompt, response, request body or SQL capture.
OBS_ENABLED=true
OBS_LOG_LEVEL=INFO
OBS_METRICS_ENABLED=false
OBS_QUALITY_EXPORT_ENABLED=false
OBS_THREAD_LINK_ENABLED=false
# Optional independent secret file (32..4096 bytes); never reuse the model key.
OBS_THREAD_LINK_KEY_FILE=
OBS_THREAD_LINK_KEY_VERSION=

# 必须配置微信登录；各账号使用独立 SQLite 数据库。
# 同时保留在内存中的用户引擎数；已淘汰用户的数据仍保存在磁盘。
TENANT_CACHE_SIZE=8
WECHAT_APP_ID=
# AppSecret 存在仓库外的文件中；不传给小程序。
WECHAT_APP_SECRET_FILE=
AUTH_SESSION_SECONDS=604800

# 单实例限流与模型尝试次数额度（按上海日期，每次真实调用尝试计数，失败不退还）
USER_REQUESTS_PER_MINUTE=60
GLOBAL_REQUESTS_PER_MINUTE=600
MODEL_MAX_CONCURRENT=2
USER_MODEL_CALLS_PER_DAY=200
GLOBAL_MODEL_CALLS_PER_DAY=5000
MODEL_MAX_OUTPUT_TOKENS=4096

# Public operational details; required for hardened deployment and policy acceptance.
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
PUBLIC_API_ORIGIN=
BACKUP_RETENTION_DAYS=7
LOGIN_GLOBAL_PER_MINUTE=300
LOGIN_CLIENT_PER_MINUTE=20
# Production bind mount, initialized with ownership 10001:10001.
# HEALTH_DATA_SOURCE=/srv/qingji/data
