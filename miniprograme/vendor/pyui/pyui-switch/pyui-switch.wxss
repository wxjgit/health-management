/* switch · 玻璃轨道 + 白玻璃旋钮；on=品牌 tint 轨道 */

.py-switch {
    position: relative;
    width: 100rpx;
    height: 60rpx;
    border-radius: var(--r-full);
    background: rgba(15, 23, 42, 0.12);
    box-shadow: inset 0 1px 3px rgba(15, 23, 42, 0.1);
    transition: background 0.25s cubic-bezier(0.32, 0.72, 0.28, 1.1);
    flex-shrink: 0;
}

.py-switch-small { width: 80rpx; height: 48rpx; }
.py-switch-large { width: 120rpx; height: 72rpx; }

.py-switch-on {
    background: var(--fui-color-primary, #015293);
}

.py-switch-knob {
    position: absolute;
    top: 4rpx;
    left: 4rpx;
    width: 52rpx;
    height: 52rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.32, 0.72, 0.28, 1.1);
    box-sizing: border-box;
}

.py-switch-small .py-switch-knob { width: 40rpx; height: 40rpx; }
.py-switch-large .py-switch-knob { width: 64rpx; height: 64rpx; }

.py-switch-on .py-switch-knob {
    transform: translateX(40rpx);
}

.py-switch-small.py-switch-on .py-switch-knob { transform: translateX(32rpx); }
.py-switch-large.py-switch-on .py-switch-knob { transform: translateX(48rpx); }

.py-switch-disabled { opacity: 0.4; }

/* 按压：旋钮横向拉长（iOS 手感） */
.py-switch-hover .py-switch-knob { width: 64rpx; }
.py-switch-small.py-switch-hover .py-switch-knob { width: 52rpx; }
.py-switch-large.py-switch-hover .py-switch-knob { width: 76rpx; }
.py-switch-hover.py-switch-on .py-switch-knob { transform: translateX(28rpx); }


.py-switch-spin {
    width: 28rpx;
    height: 28rpx;
    border-radius: 50%;
    background: conic-gradient(from 0deg, rgba(60, 60, 67, 0) 0%, rgba(60, 60, 67, 0.65) 100%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4rpx), #000 calc(100% - 3rpx));
    mask: radial-gradient(farthest-side, transparent calc(100% - 4rpx), #000 calc(100% - 3rpx));
    animation: py-switch-spin 0.9s linear infinite;
}

@keyframes py-switch-spin {
    to { transform: rotate(360deg); }
}
