@import "./vendor/pyui/common/tokens.wxss";
page {
  --fui-color-primary: #2854ea;
  background: #eef4f5;
  color: #17243d;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}
.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 26rpx 30rpx calc(196rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  isolation: isolate;
  background: linear-gradient(
    155deg,
    #e7f4eb 0,
    #e2f1fa 600rpx,
    #f1f4f5 1100rpx,
    #f9f2e9 100%
  );
}
.page-ambient {
  position: absolute;
  z-index: -1;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    155deg,
    #e7f4eb 0%,
    #e2f1fa 24%,
    #f1f4f5 52%,
    #f9f2e9 100%
  );
}
.ambient-orb {
  position: absolute;
  border-radius: 50%;
  opacity: 0.5;
}
.ambient-mint {
  width: 560rpx;
  height: 560rpx;
  left: -280rpx;
  top: 580rpx;
  background: radial-gradient(circle, #cff0dc, transparent 70%);
}
.ambient-blue {
  width: 700rpx;
  height: 700rpx;
  right: -340rpx;
  top: 40rpx;
  background: radial-gradient(circle, #b5e4ff, transparent 70%);
}
.page-heading {
  margin: 0 4rpx 12rpx;
}
.brand-row,
.brand-lockup {
  display: flex;
  align-items: center;
}
.brand-row {
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.brand-lockup {
  gap: 13rpx;
}
.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 20rpx;
}
.ui-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  display: inline-block;
  vertical-align: middle;
}
.brand-mark .ui-icon {
  width: 32rpx;
  height: 32rpx;
}
.brand-name {
  font-size: 35rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
}
.brand-divider {
  color: #aab6c2;
  font-weight: 300;
}
.brand-note {
  color: #7d8c9d;
  font-size: 23rpx;
}
.brand-spark {
  font-size: 36rpx;
  color: #4778a4;
  padding-right: 8rpx;
}
.eyebrow {
  color: #75869a;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.title {
  font-size: 43rpx;
  line-height: 1.4;
  font-weight: 650;
  letter-spacing: -1rpx;
  margin: 0 0 16rpx;
}
.page-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin: 0 4rpx 30rpx;
  color: #7d8a9b;
  font-size: 23rpx;
}
.page-intro > text {
  flex: 1;
  min-width: 0;
}
.card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 10rpx 36rpx rgba(78, 105, 133, 0.035);
}
.subtitle {
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 600;
  margin: 6rpx 0 14rpx;
  letter-spacing: -0.3rpx;
}
.section-kicker {
  color: #8090a1;
  font-size: 19rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.5;
}
.muted {
  color: #7d8a9c;
  font-size: 24rpx;
  line-height: 1.7;
  margin: 12rpx 0;
  overflow-wrap: break-word;
}
button {
  box-sizing: border-box;
  margin: 18rpx 0;
  padding: 16rpx 24rpx;
  min-height: 76rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
  color: #576b83;
  background: rgba(226, 235, 241, 0.7);
  border-radius: 40rpx;
  border: 1rpx solid transparent;
  white-space: normal;
}
button::after {
  border: 0;
}
button[disabled] {
  color: #a1adba;
  background: #e8edf1;
  opacity: 0.72;
}
button[size="mini"] {
  font-size: 23rpx;
  padding: 10rpx 20rpx;
  min-height: 56rpx;
}
button.primary {
  background: #2854ea;
  color: white;
  border: 1rpx solid #2854ea;
  box-shadow: 0 8rpx 22rpx rgba(40, 84, 234, 0.13);
}
button.primary[disabled] {
  color: #f4f7ff;
  background: #a4b7ed;
  border-color: transparent;
  box-shadow: none;
}
button.danger {
  color: #bd655f;
  background: #fbefeb;
}
.row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  align-items: center;
}
.row button {
  flex: 1;
  min-width: 170rpx;
}
.row button[size="mini"] {
  min-width: 130rpx;
}
.field {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(137, 159, 181, 0.12);
  font-size: 26rpx;
}
.field:last-child {
  border-bottom: 0;
}
input,
textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  background: rgba(232, 240, 246, 0.72);
  color: #24334d;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin: 14rpx 0;
  font-size: 28rpx;
  line-height: 1.7;
}
input {
  min-height: 80rpx;
}
textarea {
  height: 190rpx;
}
.error {
  padding: 22rpx 26rpx;
  margin: 20rpx 0;
  border-radius: 26rpx;
  color: #a95750;
  background: #fff1ec;
  border: 1rpx solid #fffcfa;
  font-size: 25rpx;
  overflow-wrap: break-word;
}
.warning {
  background: #fcf5e9;
  color: #9a7b46;
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
  line-height: 1.7;
  margin: 18rpx 0;
  font-size: 24rpx;
}
.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6d87a0;
  margin: 10rpx 0;
}
.link {
  color: #2854ea;
  font-size: 24rpx;
}
.danger {
  color: #bd655f;
}
.fold {
  border-top: 1rpx solid rgba(137, 159, 181, 0.13);
  margin: 10rpx 0;
}
.page > .fold {
  background: rgba(255, 255, 255, 0.65);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  padding: 0 24rpx;
}
.fold-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 0;
  min-height: 44rpx;
  box-sizing: border-box;
  color: #6f849e;
  font-size: 25rpx;
}
.fold-chevron {
  font-size: 30rpx;
  color: #98a9bd;
  transition: transform 0.2s;
}
.fold-chevron.is-open {
  transform: rotate(180deg);
}
.fold-body {
  padding-bottom: 18rpx;
}
.fold-body .card {
  border: 0;
  box-shadow: none;
  background: transparent;
  padding: 0 2rpx;
  margin: 0;
}
.inset {
  margin: 22rpx 0;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(229, 239, 247, 0.55);
}
.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0;
}
.metric {
  flex: 1;
  min-width: 122rpx;
  box-sizing: border-box;
  padding: 16rpx 8rpx;
  text-align: center;
  border-radius: 24rpx;
  background: rgba(230, 239, 246, 0.55);
}
.metric-value {
  color: #263d65;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}
.metric .muted {
  margin: 6rpx 0 0;
  font-size: 19rpx;
  white-space: nowrap;
}
.message {
  background: #ffffff;
  border-color: #e5eaf0;
  margin-right: 32rpx;
  border-radius: 28rpx;
  border-top-left-radius: 10rpx;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  line-height: 1.85;
}
.message.user {
  width: fit-content;
  max-width: 85%;
  box-sizing: border-box;
  padding: 20rpx 28rpx;
  background: #edf0f7;
  color: #34415b;
  border-color: #dce2ed;
  box-shadow: none;
  margin-left: auto;
  margin-right: 0;
  border-radius: 24rpx;
  border-top-right-radius: 8rpx;
}
.message.user .message-meta {
  color: #768299;
  font-size: 20rpx;
  margin-bottom: 6rpx;
  justify-content: flex-end;
}
.message.user .message-avatar {
  display: none;
}
.message-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #8091a5;
  font-size: 22rpx;
  margin-bottom: 18rpx;
  white-space: normal;
}
.message-avatar {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2854ea;
  background: #e5efff;
  border-radius: 14rpx;
  font-size: 29rpx;
}
.message-avatar.is-user {
  color: #477264;
  background: #f2faf6;
  font-size: 20rpx;
}
.highlight {
  border: 2rpx solid #8cb8f0;
  box-shadow: 0 8rpx 28rpx rgba(61, 118, 213, 0.09);
}
.refresh-button {
  color: #8e9bab;
  background: transparent;
  border: 1rpx solid #dbe4eb;
  font-size: 23rpx;
  margin-top: 36rpx;
}
.notice-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  width: auto;
  margin: 0;
  padding: 9rpx 16rpx !important;
  color: #72869e;
  background: rgba(255, 255, 255, 0.58);
  border-color: rgba(255, 255, 255, 0.9);
}
.notice-button .ui-icon {
  width: 25rpx;
  height: 25rpx;
}
.health-overview {
  position: relative;
  margin-bottom: 26rpx;
  padding: 28rpx;
  border-radius: 42rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  background: linear-gradient(
    125deg,
    rgba(217, 242, 223, 0.8),
    rgba(185, 231, 255, 0.85) 49%,
    rgba(250, 242, 229, 0.9)
  );
  box-shadow: 0 14rpx 42rpx rgba(78, 123, 156, 0.07);
  overflow: hidden;
}
.overview-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.overview-date {
  margin-top: 5rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #6e8aa0;
}
.overview-link {
  margin: 0;
  width: auto;
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #52789b;
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx solid rgba(255, 255, 255, 0.76);
}
.overview-link text {
  margin-left: 12rpx;
  font-size: 25rpx;
}
.overview-scene {
  height: 355rpx;
  position: relative;
  margin: 6rpx -8rpx 0;
}
.scene-orbit {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 50%;
  left: 50%;
  top: 47%;
  transform: translate(-50%, -50%);
}
.orbit-outer {
  width: 440rpx;
  height: 290rpx;
  transform: translate(-50%, -50%) rotate(-17deg);
}
.orbit-inner {
  width: 320rpx;
  height: 320rpx;
  border-style: dashed;
  border-color: rgba(92, 145, 187, 0.17);
}
.intake-core {
  position: absolute;
  left: 50%;
  top: 47%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 232rpx;
  height: 232rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(245, 252, 255, 0.55);
  box-shadow:
    inset 0 0 36rpx rgba(255, 255, 255, 0.55),
    0 12rpx 38rpx rgba(91, 150, 193, 0.05);
}
.core-spark {
  color: #4e80bb;
  font-size: 25rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}
.core-number {
  color: #1e3e70;
  font-size: 60rpx;
  font-weight: 650;
  letter-spacing: -3rpx;
  line-height: 1.15;
}
.core-label {
  font-size: 20rpx;
  color: #7a93ae;
  margin-top: 12rpx;
}
.health-pin {
  position: absolute;
  z-index: 1;
  display: flex;
  gap: 12rpx;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  padding: 12rpx 18rpx;
  background: rgba(255, 255, 255, 0.83);
  box-shadow: 0 6rpx 22rpx rgba(86, 118, 146, 0.04);
}
.pin-weight {
  left: 0;
  top: 51rpx;
}
.pin-sleep {
  right: 0;
  top: 174rpx;
}
.pin-move {
  left: 34rpx;
  bottom: 17rpx;
  padding: 10rpx 18rpx;
  color: #6988a5;
  font-size: 21rpx;
}
.pin-move .ui-icon {
  width: 25rpx;
  height: 25rpx;
}
.pin-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 5rpx solid #e6f4ef;
}
.dot-mint {
  background: #73b9a2;
}
.dot-blue {
  background: #78b3df;
  border-color: #e9f3fc;
}
.pin-label {
  font-size: 19rpx;
  line-height: 1.4;
  color: #8b99a8;
}
.pin-value {
  color: #344e72;
  font-weight: 600;
  line-height: 1.5;
  font-size: 27rpx;
}
.pin-value text {
  font-size: 19rpx;
  font-weight: 400;
}
.overview-bottom {
  position: relative;
  padding: 20rpx 6rpx 2rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.6);
}
.overview-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.summary-number {
  font-size: 36rpx;
  font-weight: 650;
  color: #2b4b76;
}
.summary-caption {
  font-size: 23rpx;
  color: #6683a0;
}
.status-pill {
  padding: 6rpx 15rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.47);
  font-size: 19rpx;
  color: #7992a8;
}
.status-pill.is-complete {
  color: #5a9e87;
}
.intake-track {
  height: 6rpx;
  margin: 19rpx 0 16rpx;
  background: rgba(112, 146, 174, 0.18);
  border-radius: 6rpx;
  overflow: hidden;
}
.intake-progress {
  height: 100%;
  background: #2d61ef;
  border-radius: 6rpx;
}
.overview-footnote {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 19rpx;
  color: #6f89a0;
  line-height: 1.6;
}
.overview-footnote text:last-child {
  flex-shrink: 0;
}
.quick-records {
  display: flex;
  gap: 12rpx;
  margin: 0 0 20rpx;
}
.quick-record {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 15rpx 8rpx;
  margin: 0;
  min-height: 68rpx;
  font-size: 23rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.6);
  color: #668199;
}
.quick-mark {
  color: #6b9a91;
  font-weight: 600;
  font-size: 21rpx;
}
.quick-record:nth-child(2) .quick-mark {
  color: #7298c5;
  font-size: 17rpx;
}
.quick-record:nth-child(3) .quick-mark {
  color: #9a96bf;
}
.quick-record:nth-child(4) .quick-mark {
  color: #b0987d;
}
.quick-plus {
  font-size: 20rpx;
  color: #a1b1c1;
}
.mode-note {
  color: #9b967e;
  font-size: 21rpx;
  padding: 2rpx 12rpx 22rpx;
  line-height: 1.7;
}
.starter-card {
  padding: 28rpx;
}
.starter-examples {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}
.starter-examples button {
  margin: 0;
  padding: 12rpx 18rpx;
  min-height: 56rpx;
  color: #7c91a7;
  background: rgba(227, 238, 246, 0.58);
  font-size: 22rpx;
  font-weight: 400;
}
.composer {
  background: linear-gradient(
    135deg,
    rgba(230, 246, 234, 0.76),
    rgba(222, 241, 252, 0.84) 48%,
    rgba(250, 244, 237, 0.86)
  );
}
.composer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.composer-caption {
  color: #96a3b0;
  font-size: 20rpx;
}
.local-mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #6b839b;
  font-size: 24rpx;
}
.local-mode-row switch {
  transform: scale(0.78);
  transform-origin: right center;
}
.composer textarea {
  caret-color: #8b9eb5;
  background: rgba(255, 255, 255, 0.63);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  margin-top: 20rpx;
}
.composer .primary {
  margin-bottom: 0;
}
.profile-hero {
  display: flex;
  align-items: center;
  gap: 23rpx;
  padding: 32rpx 10rpx 38rpx;
}
.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  flex-shrink: 0;
  border-radius: 38rpx;
  border: 2rpx solid white;
  background: linear-gradient(120deg, #d4eddd, #c0e4fa);
}
.profile-avatar .ui-icon {
  width: 50rpx;
  height: 50rpx;
}
.profile-hero .subtitle {
  font-size: 27rpx;
  margin-top: 8rpx;
}
.profile-hero .muted {
  margin-bottom: 0;
  font-size: 22rpx;
}
.settings-hub {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.hub-tile {
  position: relative;
  flex: 0 0 48%;
  width: 48%;
  min-width: 0;
  margin: 0 0 18rpx;
  padding: 22rpx 20rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid white;
  border-radius: 32rpx;
}
.hub-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: #e6f1fa;
  border-radius: 20rpx;
  margin-bottom: 19rpx;
}
.hub-icon .ui-icon {
  width: 31rpx;
  height: 31rpx;
}
.hub-tile:nth-child(2) .hub-icon {
  background: #e9f2e9;
}
.hub-tile:nth-child(3) .hub-icon {
  background: #efedf7;
}
.hub-tile:nth-child(4) .hub-icon {
  background: #f7eee4;
}
.hub-title {
  font-size: 27rpx;
  color: #465d79;
}
.hub-detail {
  color: #9aa7b6;
  font-size: 20rpx;
  font-weight: 400;
  margin-top: 6rpx;
}
.hub-arrow {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  color: #adbac8;
  font-size: 25rpx;
}
.card.filter-card {
  padding: 0 28rpx;
  border-radius: 22rpx;
}
.filter-card > .fold {
  margin-top: 0;
  border-top: 0;
}
.filter-card > .fold > .fold-title {
  padding: 18rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
}
.filter-card .field {
  border-bottom: 0;
  padding: 10rpx 0;
}
.filter-card .select-field,
.filter-card .date-field {
  padding: 16rpx 22rpx;
  background: #edf3f8;
  border-radius: 24rpx;
  color: #71869e;
}
.target-fields {
  display: flex;
  flex-wrap: wrap;
  gap: 0 22rpx;
}
.target-fields > .field {
  box-sizing: border-box;
  width: calc(50% - 11rpx);
  border: 0;
  padding: 8rpx 0;
}
.target-fields > .field:last-child {
  width: 100%;
}
.target-fields input {
  font-size: 32rpx;
  margin: 8rpx 0;
}
.trend {
  display: flex;
  height: 200rpx;
  gap: 5rpx;
  margin: 28rpx 0 12rpx;
}
.trend-column {
  flex: 1;
  min-width: 0;
}
.trend-track {
  height: 160rpx;
  display: flex;
  align-items: flex-end;
