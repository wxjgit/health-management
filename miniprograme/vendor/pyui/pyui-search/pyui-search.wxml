<view class="py-search" style="{{background === '#FFFFFF' ? '' : 'background:' + background + ';'}}border-radius:{{radius}}rpx;" bindtap="onWrapTap">
    <view class="py-search-box glass-field" style="{{boxBackground === '#F5F6F7' ? '' : 'background:' + boxBackground + ';'}}">
        <image class="py-search-icon" src="data:image/svg+xml;base64,"></image>
        <input wx:if="{{!disabled}}" class="py-search-input" style="font-size:{{size}}rpx;{{color ? 'color:' + color + ';' : ''}}"
            value="{{value}}" type="{{type}}" placeholder="{{placeholder}}"
            placeholder-style="color:{{placeholderColor === '#B2B2B2' ? '#94a3b8' : placeholderColor}};font-size:{{size}}rpx;"
            focus="{{focus}}" maxlength="{{maxlength}}" confirm-type="search"
            bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="onConfirm" />
        <view wx:if="{{!disabled && value}}" class="py-search-clear" catchtap="onClear">
            <text class="py-search-clear-icon">✕</text>
        </view>
        <text wx:if="{{disabled}}" class="py-search-placeholder" style="font-size:{{size}}rpx;color:{{placeholderColor === '#B2B2B2' ? '#94a3b8' : placeholderColor}};">{{placeholder}}</text>
    </view>
    <view wx:if="{{showAction}}" class="py-search-action" style="color:{{actionColor}};" bindtap="onActionTap">{{actionText}}</view>
</view>
