[Unit]
Description=Qingji health API (uvicorn, all interfaces; protect via host firewall/reverse proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/qingji
EnvironmentFile=/etc/qingji/env
ExecStart=/opt/qingji/.venv/bin/python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --workers 1 --limit-concurrency 32 --no-access-log --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=3
# 数据目录仅服务用户可写；禁止越权提升
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/qingji/data

[Install]
WantedBy=multi-user.target
