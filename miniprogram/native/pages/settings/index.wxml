<import src="../../templates/common.wxml"/><view class="page"><template is="header" data="{{title:'我的健康空间',error,loading,busy,pending}}"/><view wx:if="{{user}}" class="card"><view>账号：{{user.id}}</view><view class="muted">健康记录仅保存在当前账号下。</view><button data-page="consent" bindtap="onGo">隐私政策与模型授权</button><button disabled="{{busy || pending}}" bindtap="onExport">导出我的数据</button><button class="danger" disabled="{{busy || pending}}" bindtap="onDeleteAccount">注销账号并清理数据</button><button disabled="{{busy || pending}}" bindtap="onLogout">退出登录</button></view>
<view class="profile-hero"><view class="profile-avatar"><image class="ui-icon" src="/assets/icons/mine-active.svg"/></view><view><view class="subtitle">我的健康档案</view><view class="muted">{{profile ? profile.height_cm + ' cm · 目标 ' + profile.goal_weight_kg + ' kg' : '补充个人档案，积累属于你的健康记录'}}</view></view></view>
<view wx:if="{{reply}}" class="card message">{{reply}}</view>
<view wx:for="{{confirmations}}" wx:key="thread_id" class="card warning"><view class="subtitle">{{item.title}}</view><view>{{item.pending_input.question}}</view><native-metrics targets="{{item.pending_input.targets}}"/><view wx:if="{{item.pending_input.target_source === 'system_default'}}" class="muted">根据个人资料估算，仅供日常参考。{{item.pending_input.target_basis}}<view wx:for="{{item.pending_input.target_warnings}}" wx:key="*this">{{item}}</view></view><view class="muted">{{item.changesText}}</view><button wx:if="{{item.retry_request}}" data-id="{{item.thread_id}}" data-mode="retry" disabled="{{busy || pending || item.status === 'resuming'}}" bindtap="onDecision">{{item.settled ? '查看确认结果' : '重试上次确认'}}</button><view wx:elif="{{!item.settled}}" class="row"><button data-id="{{item.thread_id}}" data-mode="approve" disabled="{{busy || pending || item.status === 'resuming'}}" bindtap="onDecision">采用计划</button><button data-id="{{item.thread_id}}" data-mode="reject" disabled="{{busy || pending || item.status === 'resuming'}}" bindtap="onDecision">保留原计划</button></view><button wx:if="{{!item.settled}}" data-id="{{item.thread_id}}" data-mode="cancel" disabled="{{busy || pending}}" bindtap="onDecision">取消草案</button></view>
<view wx:if="{{active}}" class="card"><view class="subtitle">当前生效计划</view><view wx:for="{{activeRows}}" wx:key="label" class="plan-target-row"><view class="plan-target-label">{{item.label}}</view><view class="plan-target-value">{{item.text}}</view></view></view>
<button class="plan-edit-trigger" data-modal="plan" bindtap="onOpen">{{active ? '更改计划' : '设置目标，生成计划'}}</button><view wx:if="{{!loading && !active}}" class="muted">尚无生效计划，可填写目标生成。</view>
<view class="settings-hub"><button wx:for="{{hubs}}" wx:key="page" class="hub-tile" data-page="{{item.page}}" bindtap="onGo"><view class="hub-icon"><image class="ui-icon" src="/assets/icons/{{item.icon}}-active.svg"/></view><view class="hub-title">{{item.title}}</view><view class="hub-detail">{{item.detail}}</view><text class="hub-arrow">↗</text></button></view><button class="plan-edit-trigger" data-modal="profile" bindtap="onOpen">个人档案</button><view wx:if="{{status}}" class="card">{{status}}</view>
<native-sheet show="{{modal === 'profile'}}" title="个人档案" busy="{{busy}}" bind:close="onClose"><view wx:if="{{error}}" class="error">{{error}}</view><native-field wx:for="{{profileFields}}" wx:key="key" name="{{item.key}}" group="profileForm" type="{{item.type || 'text'}}" label="{{item.label}}" value="{{item.value}}" options="{{item.options || []}}" disabled="{{busy}}" bind:change="onField"/><pyui-button slot="actions" text="保存档案" loading="{{busy}}" disabled="{{busy || pending || loading}}" bind:click="onSaveProfile"/></native-sheet>
<native-sheet show="{{modal === 'plan'}}" title="{{active ? '更改计划' : '设置目标，生成计划'}}" busy="{{busy}}" bind:close="onClose"><view wx:if="{{error}}" class="error">{{error}}</view><view class="muted">确认新计划后，目标才会更新。</view><view class="plan-editor"><native-field wx:for="{{planFields}}" wx:key="key" name="{{item.key}}" group="planForm" type="digit" label="{{item.label}}" value="{{item.value}}" disabled="{{busy}}" bind:change="onField"/></view><button wx:if="{{defaults.status === 'ready'}}" disabled="{{busy || pending}}" bindtap="onDefaults">使用建议目标</button><view wx:else class="warning">{{defaults.reason}}</view><native-fold title="建议目标的参考说明"><view>{{defaults.basis}}</view><view wx:for="{{defaults.warnings}}" wx:key="*this" class="warning">{{item}}</view><view wx:for="{{defaults.sources}}" wx:key="url" class="link field" data-url="{{item.url}}" bindtap="onSource">{{item.title}} · 点击复制链接</view></native-fold><textarea value="{{note}}" maxlength="500" placeholder="备注或需求（选填）" disabled="{{busy}}" bindinput="onNote"/><pyui-button slot="actions" text="生成计划草案" loading="{{busy}}" disabled="{{busy || pending || loading}}" bind:click="onPropose"/></native-sheet>
<template is="footer" data="{{busy,loading}}"/></view>
