<import src="../../templates/common.wxml"/><view class="page"><template is="header" data="{{title:'偏好与提醒',error,loading,busy,pending}}"/><block wx:if="{{draft}}"><view class="card"><native-fold title="调整健康评分权重"><view class="muted">总和必须为100%。缺少个人数据的维度保持未知。</view><native-field wx:for="{{weightRows}}" wx:key="key" name="{{item.key}}" group="weights" label="{{item.label}}" value="{{item.value}}" type="digit" disabled="{{busy}}" bind:change="onField"/><view>当前合计：{{total}}%</view><view wx:if="{{suggestion}}" class="inset"><view>{{suggestion.reason}}</view><view class="muted">{{suggestion.limitations}}</view><button disabled="{{busy}}" bindtap="onSuggestion">填入权重建议（保存后生效）</button></view></native-fold></view><view class="card"><view class="subtitle">提醒与复盘</view><view>开启站内提醒 <switch checked="{{draft.notifications_enabled}}" disabled="{{busy}}" bindchange="onNotify"/></view><native-field wx:for="{{timeRows}}" wx:key="key" name="{{item.key}}" group="draft" type="{{item.type}}" label="{{item.label}}" value="{{item.value}}" options="{{item.options || []}}" disabled="{{busy}}" bind:change="onField"/><view class="muted">时区 Asia/Shanghai。服务运行时生成站内消息，关闭小程序不等于微信订阅推送。</view></view><pyui-button text="保存设置" disabled="{{busy || pending}}" loading="{{busy}}" bind:click="onSave"/><view wx:if="{{status}}" class="card">{{status}}</view></block><template is="footer" data="{{busy,loading}}"/></view>
