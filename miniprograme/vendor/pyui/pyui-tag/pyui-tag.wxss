/* tag · 玻璃 tint 标签：theme 色 12% 底 + 30% 描边（light），dark=实色底白字，outline=纯描边 */

.py-tag {
    display: inline-flex;
    align-items: center;
    gap: 8rpx;
    padding: 6rpx 16rpx;
    border-radius: 8rpx;
    box-sizing: border-box;
    max-width: 100%;
    transition: opacity 0.15s;
}

.py-tag-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.py-tag-round { border-radius: var(--r-full); }
.py-tag-mark { border-radius: 0 var(--r-full) var(--r-full) 0; }

.py-tag-small { font-size: 20rpx; padding: 4rpx 12rpx; }
.py-tag-medium { font-size: 24rpx; }
.py-tag-large { font-size: 28rpx; padding: 10rpx 24rpx; }

.py-tag-default { background: rgba(15, 23, 42, 0.06); border: 1px solid rgba(15, 23, 42, 0.12); color: var(--c-sub); }
.py-tag-primary { background: rgba(1, 82, 147, 0.12); border: 1px solid rgba(1, 82, 147, 0.3); color: var(--fui-color-primary, #015293); }
.py-tag-warning { background: rgba(255, 183, 3, 0.12); border: 1px solid rgba(255, 183, 3, 0.3); color: var(--fui-color-warning, #FFB703); }
.py-tag-danger { background: rgba(255, 43, 43, 0.12); border: 1px solid rgba(255, 43, 43, 0.3); color: var(--fui-color-danger, #FF2B2B); }
.py-tag-success { background: rgba(9, 190, 79, 0.12); border: 1px solid rgba(9, 190, 79, 0.3); color: var(--fui-color-success, #09BE4F); }

.py-tag-dark.py-tag-default { background: rgba(15, 23, 42, 0.72); color: #fff; }
.py-tag-dark.py-tag-primary { background: var(--fui-color-primary, #015293); color: #fff; }
.py-tag-dark.py-tag-warning { background: var(--fui-color-warning, #FFB703); color: #fff; }
.py-tag-dark.py-tag-danger { background: var(--fui-color-danger, #FF2B2B); color: #fff; }
.py-tag-dark.py-tag-success { background: var(--fui-color-success, #09BE4F); color: #fff; }
.py-tag-outline { background: transparent; }
.py-tag-light-outline { background: rgba(255, 255, 255, 0.4); }

.py-tag-disabled { opacity: 0.5; }

.py-tag-close {
    font-size: 24rpx;
    line-height: 1;
    padding: 4rpx;
    color: inherit;
    opacity: 0.7;
}
