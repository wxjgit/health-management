<view class="page">
  <view class="title">隐私与模型授权</view>
  <view wx:if="{{loading}}" class="muted">正在读取…</view>
  <native-agreements wx:if="{{policy}}" policy="{{policy}}" value="{{agreement}}" disabled="{{busy}}" bind:change="onAgreement" />
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <pyui-button wx:if="{{policy}}" text="保存授权选择" loading="{{busy}}" disabled="{{busy || !policy.ready || !agreement.privacy || !agreement.health}}" bind:click="onSave" />
  <view class="muted">如不再同意本服务处理健康信息，可在“我的”注销账号并清理数据。</view>
  <view wx:if="{{saved}}" class="card">授权选择已保存。</view>
  <button wx:if="{{error}}" class="refresh-button" bindtap="reload">重试读取</button>
</view>
