<view class="card">
  <view>运营方：{{policy.operator || '尚未配置'}}</view>
  <view>联系邮箱：{{policy.contact || '尚未配置'}}</view>
  <view wx:if="{{!policy.ready}}" class="warning">服务尚未完成运营信息配置，暂不能建立账号。</view>
  <view class="fold-title" bindtap="togglePolicy">隐私政策与用户协议 <text>{{policyOpen ? '⌃' : '⌄'}}</text></view>
  <block wx:if="{{policyOpen}}">
    <view wx:for="{{policy.privacy}}" wx:key="index" class="field">{{item}}</view>
    <view wx:for="{{policy.terms}}" wx:key="index" class="field">{{item}}</view>
  </block>
  <view class="field agreement-row">
    <text class="agreement-copy">我已阅读并同意隐私政策与用户协议</text>
    <switch class="agreement-toggle" data-key="privacy" checked="{{value.privacy}}" disabled="{{disabled}}" bindchange="onToggle" />
  </view>
  <view class="field agreement-row">
    <text class="agreement-copy">我单独同意为记录与复盘处理我自主提交的健康信息</text>
    <switch class="agreement-toggle" data-key="health" checked="{{value.health}}" disabled="{{disabled}}" bindchange="onToggle" />
  </view>
  <view class="fold-title" bindtap="toggleModel">可选：外部模型数据处理说明 <text>{{modelOpen ? '⌃' : '⌄'}}</text></view>
  <block wx:if="{{modelOpen}}">
    <view wx:for="{{policy.model_notice}}" wx:key="index" class="field">{{item}}</view>
  </block>
  <view class="field agreement-row">
    <text class="agreement-copy">另行同意将必要数据发送给上述外部模型（可随时撤回）</text>
    <switch class="agreement-toggle" data-key="model" checked="{{value.model}}" disabled="{{disabled || !policy.model_available}}" bindchange="onToggle" />
  </view>
  <view class="muted">不选择模型授权仍可使用基础记录。撤回不影响此前已保存的记录。</view>
</view>
