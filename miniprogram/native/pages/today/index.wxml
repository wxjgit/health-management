<import src="../../templates/common.wxml"/><view class="page"><template is="header" data="{{title:'今日概览',error,loading,busy,pending}}"/><block wx:if="{{daily}}"><view class="card"><view>{{daily.date}} · {{daily.record_count}} 条记录</view><native-metrics targets="{{daily.totals}}"/><view class="muted">{{daily.totals.unknown_items ? '营养未知，汇总仅含已知部分' : '汇总依据已记录内容，不代表全天实际摄入'}}</view><view class="field">体重：{{daily.weightText}} kg</view><view class="field">睡眠：{{daily.sleepText}} 分钟</view><view class="field">运动：{{daily.exercise_minutes}} 分钟</view></view><view wx:if="{{daily.targets}}" class="card"><native-fold title="查看目标与剩余额度"><native-metrics targets="{{daily.targets}}"/><view class="subtitle">距离目标（仅依据已知摄入）</view><native-metrics targets="{{daily.remaining}}"/></native-fold></view><view class="card"><view>当天饮食记录：{{daily.diet_complete ? '已标记完整' : '未标记完整'}}</view><view class="muted">确认全天饮食都已记下后，再标记完整。</view><button disabled="{{busy || pending}}" bindtap="onComplete">{{daily.diet_complete ? '撤销完整标记' : '标记当天饮食完整'}}</button></view><view wx:for="{{daily.events}}" wx:key="id" class="card"><view class="tag">{{item.label}} · {{item.occurred_at}}</view><view>{{item.raw_text}}</view></view><view wx:if="{{!daily.events.length}}" class="card">今天还没有记录，去记录页写下第一条吧。</view></block><template is="footer" data="{{busy,loading}}"/></view>
