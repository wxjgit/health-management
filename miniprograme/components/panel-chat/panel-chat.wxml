<!-- panel-chat：记录（对话）面板 · 虚拟页（宿主 pages/home 切换，无 reLaunch 闪屏） -->
<view class="chat-panel" style="height:{{panelH}}px">
  <view class="chat-mode">
    <view class="chat-mode-tag {{mode === 'model_allowed' ? '' : 'is-local'}}">
      <view class="dot"></view>{{mode === 'model_allowed' ? '模型模式' : '纯本地 local_only'}}
    </view>
    <view class="chat-bell" bindtap="goMessages">
      <pyui-icon name="mail" size="34rpx" color="#64748b"></pyui-icon>
      <view wx:if="{{unread > 0}}" class="chat-badge">{{unread > 99 ? '99+' : unread}}</view>
    </view>
  </view>

  <view wx:if="{{offline}}" class="chat-offline">
    <pyui-icon name="warning" size="26rpx" color="#b04257"></pyui-icon>
    <text>当前离线 · 输入内容已保存本地，联网后按原编号重试，不会重复记录</text>
  </view>

  <view wx:if="{{pendingQuestion}}" class="chat-pending" bindtap="focusInput">
    <pyui-icon name="info" size="26rpx" color="#8f6420"></pyui-icon>
    <text class="chat-pending-tx">待补充：{{pendingQuestion}}</text>
  </view>

  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:for="{{messages}}" wx:key="id" id="m{{item.id}}" class="msg-row {{item.role === 'user' ? 'is-user' : 'is-bot'}}">
      <view wx:if="{{item.role === 'bot'}}" class="avatar-bot"><pyui-icon name="leaf" size="34rpx" color="#ffffff"></pyui-icon></view>
      <view class="msg-col">
        <view class="bub {{item.role === 'user' ? 'bub-user' : 'bub-bot'}}">
          <text user-select>{{item.text}}</text>
        </view>
        <view wx:if="{{item.savedCount}}" class="msg-saved" bindtap="goHistory">
          <pyui-icon name="success" size="24rpx" color="#09be4f"></pyui-icon>
          <text>已保存 {{item.savedCount}} 条记录 · 查看</text>
        </view>
        <view wx:if="{{item.trace && item.trace.length}}" class="msg-trace">
          <view class="trace-hd" bindtap="toggleTrace" data-id="{{item.id}}">
            <pyui-icon name="{{item.traceOpen ? 'chevron-down' : 'chevron-right'}}" size="22rpx" color="#94a3b8"></pyui-icon>
            <text>处理过程 · {{item.trace.length}} 步</text>
          </view>
          <view wx:if="{{item.traceOpen}}" class="trace-bd">
            <view wx:for="{{item.trace}}" wx:for-item="t" wx:key="title" class="trace-step">
              <view class="trace-dot {{t.source === 'model' ? 'is-model' : 'is-local'}}"></view>
              <view class="trace-tx"><text class="trace-tt">{{t.title}}</text><text class="trace-dt">{{t.detail}}</text></view>
            </view>
          </view>
        </view>
        <text class="msg-time">{{item.time}}</text>
      </view>
    </view>

    <view wx:if="{{sending}}" class="msg-row is-bot">
      <view class="avatar-bot"><pyui-icon name="leaf" size="34rpx" color="#ffffff"></pyui-icon></view>
      <view class="bub bub-bot typing"><view class="tdot"></view><view class="tdot"></view><view class="tdot"></view></view>
    </view>
    <view id="chat-bottom" style="height:20rpx"></view>
  </scroll-view>

  <scroll-view class="chat-quick" scroll-x wx:if="{{!sending}}">
    <view class="qj-chips qj-chips--scroll">
      <view wx:for="{{quick}}" wx:key="text" class="qj-chip" bindtap="fillQuick" data-text="{{item.text}}">
        <pyui-icon name="{{item.icon}}" size="26rpx" color="#015293"></pyui-icon>
        <text>{{item.text}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="chat-input">
    <view class="ci-box">
      <input class="ci-field" value="{{draft}}" focus="{{focus}}" placeholder="{{recording ? '正在听…' : '说说你吃了什么、睡得怎么样…'}}"
        confirm-type="send" bindinput="onInput" bindconfirm="onSend" adjust-position="{{false}}" cursor-spacing="20"
        bindlongpress="onMicDown" />
      <view class="ci-mic {{recording ? 'is-rec' : ''}}" catchtouchstart="onMicDown" catchtouchend="onMicUp" catchtouchcancel="onMicUp">
        <pyui-icon name="mic" size="34rpx" color="{{recording ? '#ffffff' : '#64748b'}}"></pyui-icon>
      </view>
      <view class="ci-send {{draft ? '' : 'is-disabled'}}" bindtap="onSend">
        <pyui-icon name="chevron-right" size="34rpx" color="#ffffff"></pyui-icon>
      </view>
    </view>
  </view>

  <!-- 录音浮层：实时识别文本 + 松手提示 -->
  <view wx:if="{{recording}}" class="voice-mask" catchtouchmove="noop">
    <view class="voice-card">
      <view class="voice-wave"><view class="vw-bar"></view><view class="vw-bar"></view><view class="vw-bar"></view><view class="vw-bar"></view><view class="vw-bar"></view></view>
      <view class="voice-text">{{voiceText || '正在聆听…'}}</view>
      <view class="voice-hint">松开结束并填入输入框</view>
    </view>
  </view>
</view>
