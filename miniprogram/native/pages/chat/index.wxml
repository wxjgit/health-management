<import src="../../templates/common.wxml"/><view class="page"><template is="header" data="{{title:'今天，记录一点好状态',error,loading,busy,pending}}"/><view class="card"><view>{{local ? '当前使用服务器本地规则，不向外部模型发送健康内容。' : '当前允许必要数据发送给已授权的模型供应商。'}}</view><button data-page="consent" bindtap="onGo">查看说明或修改模型授权</button></view>
<view class="page-intro"><text>饮食、睡眠、运动，每一点都值得记下。</text><button class="notice-button" size="mini" data-page="notifications" bindtap="onGo">站内消息</button></view>
<view class="card composer"><view class="subtitle">记下此刻</view><view wx:if="{{correction}}" class="warning">正在纠正：{{correction.raw_text}}</view><view wx:if="{{selected}}" class="warning">正在回答：{{selected.pending_input.question}}</view><button wx:if="{{selected || correction}}" disabled="{{busy || pending}}" bindtap="onNew">另开一条新记录</button><button wx:for="{{selected.pending_input.options}}" wx:key="id" data-option="{{item.id}}" disabled="{{busy || pending || selected.retry_request}}" bindtap="onSend">{{item.label}}</button>
<view class="quick-records"><button wx:for="{{quick}}" wx:key="label" class="quick-record" data-text="{{item.text}}" disabled="{{busy || pending || selected || correction}}" bindtap="onExample">{{item.label}} ＋</button></view>
<textarea value="{{text}}" maxlength="4000" disabled="{{busy || pending || selected.retry_request}}" placeholder="{{focused ? '' : selected ? '补充所选问题…' : '用一句话开始记录…'}}" bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" adjust-position/>
<view wx:if="{{busy}}" class="muted">正在处理，随后将校验并保存或查询。</view><pyui-button text="发送" loading="{{busy}}" disabled="{{busy || pending || !loaded || !text || selected.retry_request}}" bind:click="onSend"/></view>
<block wx:if="{{loaded}}"><button class="daily-overview-trigger" data-modal="overview" bindtap="onOpen">查看今日状态</button><view wx:if="{{health.mode === 'demo'}}" class="mode-note">演示数据仅供体验，营养信息不完整时保持未知。</view>
<view wx:if="{{!messages.length}}" class="card starter-card"><view class="subtitle">从第一条记录开始</view><view class="muted">不用填表，像聊天一样记下今天。</view><button wx:for="{{examples}}" wx:key="*this" data-text="{{item}}" bindtap="onExample">{{item}}</button></view>
<view wx:for="{{newestMessages}}" wx:key="id" class="card message {{item.role === 'user' ? 'user' : ''}}"><view wx:if="{{item.role !== 'user'}}" class="message-meta">✦ 轻记 · 健康助手</view><text user-select>{{item.text}}</text><view wx:for="{{item.cards}}" wx:for-item="card" wx:key="index" class="inset"><block wx:if="{{card.type === 'meal'}}"><view>{{card.title || '餐食记录'}} · {{card.date}}</view><native-metrics targets="{{card.totals}}"/><view wx:if="{{card.totals.unknown_items}}" class="warning">{{card.totals.unknown_items}} 项营养未知，汇总仅含已知部分。</view><native-fold title="估算来源与判断细节"><view wx:for="{{card.items}}" wx:key="index" class="field"><view>{{item.name}} · {{item.quantity == null ? '分量未知' : item.quantity + item.unit}}</view><view class="muted">{{item.nutrition_source}} · {{item.uncertainty}} {{item.nutrition_status === 'estimated' ? '粗估值' : ''}}</view></view><view>评分覆盖 {{card.coverage}}% · 综合分 {{card.score == null ? '未知' : card.score}}</view><view wx:for="{{card.notes}}" wx:key="*this" class="muted">{{item}}</view></native-fold></block></view><native-evidence rows="{{item.evidence_refs}}"/></view>
<view wx:if="{{olderError}}" class="muted">较早对话加载失败，请重试。</view><button wx:if="{{hasOlder}}" disabled="{{olderLoading || loading || pending}}" loading="{{olderLoading}}" bindtap="loadOlder">{{olderLoading ? '正在加载…' : olderError ? '重新加载' : '查看更早对话'}}</button>
<view wx:for="{{workflows}}" wx:key="thread_id" class="card"><view class="tag">{{item.pending_input.optional ? '可选补充' : '待补充'}} · {{item.status === 'resuming' ? '处理中' : item.status === 'resume_failed' ? '上次补充失败' : '等待回答'}}</view><view>{{item.pending_input.prompt || item.pending_input.question}}</view><block wx:if="{{item.retry_request}}"><view class="muted">上次回答：{{item.retry_request.text}}</view><button data-id="{{item.thread_id}}" disabled="{{busy || pending || item.status === 'resuming'}}" bindtap="onRetry">重新提交回答</button></block><button wx:else data-id="{{item.thread_id}}" disabled="{{busy || pending || item.status === 'resuming'}}" bindtap="onSelect">{{selectedId === item.thread_id ? '已选择此追问' : '回答此追问'}}</button><button data-id="{{item.thread_id}}" disabled="{{busy || pending}}" bindtap="onCancel">取消补充</button></view>
<button wx:if="{{hasPlan}}" data-page="settings" bindtap="onGo">前往我的，确认计划</button><native-fold wx:if="{{expired.length}}" title="已结束的问答 · {{expired.length}}"><view class="muted">如需继续，请重新描述；已保存的记录可在足迹中查看。</view><view wx:for="{{expired}}" wx:key="thread_id" class="field">{{item.reply || item.pending_input.question || '这次问答已结束'}}</view></native-fold></block>
<native-sheet show="{{modal === 'overview'}}" title="今日状态" bind:close="onClose"><view wx:if="{{daily}}" class="health-overview"><view class="overview-top"><view><view class="section-kicker">TODAY · 今日状态</view><view class="overview-date">{{daily.dateText}}</view></view></view><view class="overview-scene"><view class="scene-orbit orbit-outer"/><view class="scene-orbit orbit-inner"/><view class="health-pin pin-weight"><view class="pin-dot dot-mint"/><view><view class="pin-label">体重</view><view class="pin-value">{{daily.weightText}} kg</view></view></view><view class="intake-core"><view class="core-spark">✦</view><view class="core-number">{{daily.intakeText}}</view><view class="core-label">已知摄入 · kcal</view></view><view class="health-pin pin-sleep"><view class="pin-dot dot-blue"/><view><view class="pin-label">睡眠</view><view class="pin-value">{{daily.sleepText}} h</view></view></view><view class="health-pin pin-move">运动 {{daily.exercise_minutes}} 分钟</view></view><view class="overview-bottom"><view class="overview-summary"><text>{{daily.record_count}} 条记录，留住今天</text><text>{{daily.diet_complete ? '饮食已记完整' : '持续记录中'}}</text></view><view class="intake-track"><view class="intake-progress" style="width:{{daily.progress}}%;"/></view><view class="overview-footnote"><text>依据已记录内容，不代表全天实际摄入</text><text>{{daily.targetText}}</text></view></view></view><pyui-button slot="actions" text="今日汇总" bind:click="onSummary"/></native-sheet>
<template is="footer" data="{{busy,loading}}"/></view>
