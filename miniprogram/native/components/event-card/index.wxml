<view wx:if="{{event}}" class="card record-item {{highlight ? 'highlight' : ''}}"><view class="tag">{{kindLabel}} · {{event.day}}</view><view class="record-text">{{event.raw_text}}</view><native-fold title="查看详情与操作"><view wx:for="{{items}}" wx:key="index" class="muted">{{item.description}}</view><native-fold title="修改记录"><button disabled="{{busy}}" loading="{{busy}}" bindtap="revisions">读取修订历史</button><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{rows}}" wx:key="version" class="field"><view>{{item.created_at}} · v{{item.version}}</view><view>{{item.raw_text}}</view><view class="muted">{{item.reason}}</view><view class="message">{{item.diff}}</view></view></native-fold><view class="row"><button size="mini" bindtap="correct">纠正</button><button size="mini" class="danger" bindtap="remove">删除记录</button></view></native-fold></view>
