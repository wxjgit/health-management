<import src="../../templates/common.wxml"/><view class="page"><template is="header" data="{{title:'长期信息',error,loading,busy,pending}}"/><view class="muted">保存明确表达的信息。自述限制和转述建议未经独立核验；撤回保留历史，隐私删除清理相关副本。</view><button disabled="{{busy || pending}}" bindtap="onEdit">新增长期信息</button>
<view wx:if="{{editing}}" class="card"><view class="subtitle">{{editing === 'new' ? '新增' : '修改'}}长期信息</view><textarea value="{{form.content}}" maxlength="500" placeholder="完整原文或描述" disabled="{{busy}}" bindinput="onContent"/><native-field wx:for="{{fields}}" wx:key="key" name="{{item.key}}" label="{{item.label}}" value="{{item.value}}" type="{{item.type || 'text'}}" options="{{item.options || []}}" disabled="{{busy}}" bind:change="onField"/><pyui-button text="保存长期信息" loading="{{busy}}" disabled="{{busy || pending}}" bind:click="onSave"/><button disabled="{{busy}}" bindtap="onCancelEdit">取消编辑</button></view>
<view wx:for="{{facts}}" wx:key="id" class="card"><view>{{item.content}}</view><view class="tag">{{item.typeLabel}} · {{item.stateLabel}}</view><view class="muted">来源：{{item.sourceLabel}}</view><view class="muted">{{item.valid_from || '未说明开始'}} — {{item.valid_until || '未说明截止'}} · {{item.enforcementLabel}}</view><view wx:if="{{item.review_reason}}" class="warning">{{item.review_reason}}</view><view wx:if="{{item.temporarily_covered}}" class="warning">当前被临时偏好覆盖，到期或撤回后恢复。</view><view wx:if="{{item.restoreText}}" class="muted">到期后恢复：{{item.restoreText}}</view><view wx:if="{{item.sourceText}}" class="muted">{{item.sourceText}}</view><view wx:if="{{item.confirmation === 'conflict'}}" class="warning">请核对同一对象的原文和适用期：{{item.conflictText}}</view><view class="row"><button size="mini" data-id="{{item.id}}" disabled="{{busy || pending}}" bindtap="onEdit">修改</button><button wx:if="{{item.hasConfirmation}}" size="mini" data-id="{{item.id}}" data-action="confirm" disabled="{{busy || pending || !item.canConfirm}}" bindtap="onFactAction">{{item.valid_until ? '仅在期限内采用' : '确认采用'}}</button><button wx:if="{{item.canRetract}}" size="mini" data-id="{{item.id}}" data-action="retract" disabled="{{busy || pending}}" bindtap="onFactAction">撤回</button><button size="mini" data-id="{{item.id}}" data-action="delete" bindtap="onFactAction">隐私删除</button></view><native-fold title="变更历史"><button data-id="{{item.id}}" data-action="history" disabled="{{busy}}" bindtap="onFactAction">读取历史</button><block wx:if="{{history.id === item.id}}"><view wx:for="{{history.rows}}" wx:key="version" class="field">v{{item.version}} · {{item.content}}<view class="muted">{{item.change_reason}} · {{item.lifeLabel}}</view></view></block></native-fold></view><view wx:if="{{!loading && !facts.length}}" class="card">暂无长期信息，也可以在记录页说“我不喜欢燕麦”。</view>
<template is="footer" data="{{busy,loading}}"/></view>
