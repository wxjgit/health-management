<import src="../../templates/common.wxml"/><view class="page"><template is="header" data="{{title:'站内消息',error,loading,busy,pending}}"/><view class="muted">在这里查看提醒和计划更新。</view><view wx:for="{{notices}}" wx:key="id" class="card"><view class="subtitle">{{item.read ? '' : '● '}}{{item.title}}</view><view class="message">{{item.body}}</view><view class="muted">{{item.created_at}}</view><button wx:if="{{!item.read}}" data-id="{{item.id}}" disabled="{{busy}}" bindtap="onRead">标为已读</button></view><view wx:if="{{!loading && !notices.length}}" class="card">暂无消息。</view><template is="footer" data="{{busy,loading}}"/></view>
