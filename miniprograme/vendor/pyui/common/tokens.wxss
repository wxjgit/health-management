/* pyui 令牌层（单一事实源）— 抽自蒜香飞行矮堇瓜 miniprograme/app.wxss 108-264 行
   组件 wxss 经 @import 引入；demo 工程 app.wxss 同样 import 本文件 */
page {
    /* 系统字体栈：iOS 即 SF/PingFang、Android 即 Roboto/厂商字体，
       数字与中文同源和谐；弃 base64 内嵌 SF-Pro（授权风险 + 包体 + 子集缺字回退怪） */
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC',
        'Helvetica Neue', 'HarmonicOS Sans', 'MiSans', Roboto, sans-serif;
    /* 全局底色与 .container 的 --page-bg 同源：容器几何刻意空出底部 safe area，
       透明 pyui-safearea 兜底露出的必须是页面底色而非模板默认白 */
    background: var(--page-bg);
}

.container {
    min-height: 100vh;   /* v3 原生滚动：固定 100vh 会让页面渐变底只绘一屏、长内容露白 */
    width: 100vw;
}

/* ── flex 工具类（原项目由 privacy 组件非 scoped 样式全局泄漏，此处显式全局化） ── */
.flex,
.flex-jc,
.flex-ac,
.flex-jb,
.flex-jc-ac,
.flex-jb-ac,
.flex-jc-col,
.flex-je-ac,
.flex-jc-ae,
.flex-ac-col,
.flex-jc-ac-col {
    display: flex;
}

.flex-jc,
.flex-jc-ac,
.flex-jc-col,
.flex-jc-ae,
.flex-jc-ac-col {
    justify-content: center;
}

.flex-jb {
    justify-content: space-between;
}

.flex-ac,
.flex-jc-ac,
.flex-jb-ac,
.flex-je-ac,
.flex-ac-col,
.flex-jc-ac-col {
    align-items: center;
}

.flex-je-ac {
    justify-content: flex-end;
}

.flex-jb-ac {
    justify-content: space-between;
}

.flex-jc-col,
.flex-ac-col,
.flex-jc-ac-col {
    flex-flow: column;
}

.flex-jc-ae {
    align-items: flex-end;
}

/* ══════════════════════════════════════════════════════════
   毛玻璃设计语言（Liquid Glass）— 源自 uniappx 版设计、
   chengshichuxing glass-* 组件原生移植。令牌 + 通用工具类。
   ══════════════════════════════════════════════════════════ */
page {
    /* 玻璃配方 */
    --glass-nav-bg: rgba(244, 246, 250, 0.72);
    --glass-bar-bg: rgba(255, 255, 255, 0.25);
    --glass-lens-bg: rgba(255, 255, 255, 0.45);
    --glass-card-bg: rgba(255, 255, 255, 0.55);
    --glass-field-bg: rgba(255, 255, 255, 0.6);
    --glass-border: rgba(255, 255, 255, 0.55);
    --glass-blur-lg: blur(24px) saturate(200%);
    --glass-blur-md: blur(14px) saturate(145%);
    --glass-blur-sm: blur(10px);
    /* 折射环（与 lens/capsule 同配方） */
    --glass-ring: inset 0 1.5px 0 rgba(255, 255, 255, 0.8),
        inset 0 -1.5px 0 rgba(255, 255, 255, 0.4),
        inset 0 0 12px rgba(255, 255, 255, 0.28),
        0 4px 16px rgba(15, 23, 42, 0.1);
    /* 文本/圆角 */
    --c-text: #0f172a;
    --c-sub: #64748b;
    --c-minor: #94a3b8;
    --r-card: 20px;
    --r-full: 999px;
    /* 页面底色渐变（内容区背景） */
    --page-bg: linear-gradient(180deg, #eef2f7 0%, #f6f7fb 40%, #f2f5fa 100%);
    /* iOS 26 组件规范（2026-10-29）：运动/圆角/发丝线令牌，见 DESIGN.md §6 */
    --ease-spring: cubic-bezier(0.32, 0.72, 0.28, 1.1);
    --dur-spring: 0.45s;
    --dur-fade: 0.25s;
    --r-alert: 68rpx;
    --r-sheet: 72rpx;
    --hairline: rgba(15, 23, 42, 0.08);
    /* 按压物理 v3（2026-10-31）：iOS 26 Liquid Glass 按压语义 = 放大 + 提亮 + 手指区高光，
       此前 .96 缩小方向作废（与 segmented/tab-bar 透镜 1.1 放大自相矛盾）；行类组件不缩放仅 tint */
    --press-scale: 1.04;
}

/* 页面根容器玻璃底色：页面 .container 内第一个 view 加此类，或直接在页面 wxss 用 var(--page-bg) */
.glass-page-bg {
    background: var(--page-bg);
}

/* 玻璃卡片：内容块通用容器 */
.glass-card {
    background: var(--glass-card-bg);
    -webkit-backdrop-filter: var(--glass-blur-md);
    backdrop-filter: var(--glass-blur-md);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-card);
    box-shadow: var(--glass-ring);
    box-sizing: border-box;
}

/* 玻璃面板：弹层/抽屉/大区块 */
.glass-panel {
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid var(--glass-border);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    box-sizing: border-box;
}

/* 玻璃输入域 */
.glass-field {
    background: var(--glass-field-bg);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 14px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
    box-sizing: border-box;
}

/* 分区标题（小节眉题） */
.section-title {
    font-size: 26rpx;
    font-weight: 600;
    color: var(--c-sub);
    letter-spacing: 2rpx;
    padding: 8rpx 12rpx;
}

/* 主文本/次文本 */
.t-main { color: var(--c-text); }
.t-sub { color: var(--c-sub); }
.t-minor { color: var(--c-minor); }

/* 语义色族（行为色/文字阶/间距，抽自原 app.wxss 首 page{} 块） */
page {
	/* 行为相关颜色 */
	--fui-color-primary: #015293;
	--fui-color-success: #09BE4F;
	--fui-color-warning: #FFB703;
	--fui-color-danger: #FF2B2B;
	--fui-color-purple: #6831FF;

	/* 文字基本颜色、其他辅助色 */
	/* 用于重量级文字信息、标题 */
	--fui-color-title: #181818;
	/* 用于普通级段落信息、引导词 */
	--fui-color-section: #333333;
	/* 用于次要标题内容 */
	--fui-color-subtitle: #7F7F7F;
	/* 用于底部标签、描述、次要文字信息 */
	--fui-color-label: #B2B2B2;
	/* 用于辅助、次要信息、禁用文字等。如：待输入状态描述文字，已点击按钮文字 */
	--fui-color-minor: #CCCCCC;
	--fui-color-white: #FFFFFF;
	/* 链接颜色 */
	--fui-color-link: #465CFF;


	/* 背景颜色 */
	--fui-bg-color: #ffffff;
	/* 页面背景底色 */
	--fui-bg-color-grey: #F1F4FA;
	/* 内容模块底色 */
	--fui-bg-color-content: #F8F8F8;
	--fui-bg-color-red: rgba(255, 43, 43, .05);
	--fui-bg-color-yellow: rgba(255, 183, 3, .1);
	--fui-bg-color-purple: rgba(104, 49, 255, .05);
	--fui-bg-color-green: rgba(9, 190, 79, .05);
	/* 点击背景色 */
	--fui-bg-color-hover: rgba(0, 0, 0, 0.2);
	/* 遮罩颜色 */
	--fui-bg-color-mask: rgba(0, 0, 0, 0.6);


	/* 边框颜色 */
	--fui-color-border: #EEEEEE;

	/* 阴影颜色 */
	--fui-color-shadow: rgba(2, 4, 38, 0.05);

	/*禁用态的透明度 */
	--fui-opacity-disabled: 0.5;

	/* 图标尺寸 */
	--fui-img-size-sm: 48rpx;
	--fui-img-size-base: 56rpx;
	--fui-img-size-middle: 64rpx;
	--fui-img-size-lg: 96rpx;

	/* 图片尺寸 */
	--fui-img-sm: 60rpx;
	--fui-img-base: 120rpx;
	--fui-img-lg: 240rpx;

	/* Border Radius */
	--fui-border-radius-sm: 16rpx;
	--fui-border-radius-base: 24rpx;
	--fui-border-radius-lg: 48rpx;
	--fui-border-radius-circle: 50%;

	/* 水平间距 */
	--fui-spacing-row-sm: 16rpx;
	--fui-spacing-row-base: 24rpx;
	--fui-spacing-row-lg: 32rpx;

	/* 垂直间距 */
	--fui-spacing-col-sm: 8rpx;
	--fui-spacing-col-base: 16rpx;
	--fui-spacing-col-lg: 24rpx;
}
