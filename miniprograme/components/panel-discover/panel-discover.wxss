/* components/panel-discover/panel-discover.wxss */
.disc-panel { display: flex; flex-direction: column; height: 100%; overflow: hidden; padding: 12rpx 24rpx 0; box-sizing: border-box; }
.disc-scroll { flex: 1; padding-bottom: 24rpx; box-sizing: border-box; }
.insight.is-stale { opacity: .6; }
.insight-ev {
  display: flex; align-items: flex-start; gap: 8rpx;
  font-size: 22rpx; color: var(--c-minor); margin-top: 14rpx;
  background: rgba(255,255,255,.5); border-radius: var(--qj-r-md);
  padding: 14rpx 18rpx; line-height: 1.6;
}
