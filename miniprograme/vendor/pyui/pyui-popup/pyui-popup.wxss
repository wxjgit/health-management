/* py-bottom-popup — iOS 26 sheet（2026-10-29 改版，DESIGN.md §6）
   解剖：grabber 横条 → 标题行（圆形玻璃关闭右上）→ 滚动体 → 安全区；
   顶圆角 --r-sheet；玻璃面 .78 白 + blur28/sat180 + 顶边高光；
   运动：上滑 --ease-spring 弹簧（与 tabbar 透镜同曲线），退场 .25s ease-in。 */

.py-popup-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    z-index: 9990;
    opacity: 0;
    transition: opacity var(--dur-fade, 0.25s) ease-in-out;
}

.py-popup-mask.show {
    opacity: 1;
}

.py-popup-box {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: var(--r-sheet, 72rpx) var(--r-sheet, 72rpx) 0 0;
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    backdrop-filter: blur(28px) saturate(180%);
    border-top: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: inset 0 1.5px 0 rgba(255, 255, 255, 0.8), 0 -12rpx 48rpx rgba(15, 23, 42, 0.12);
    /* 退场：匀速下沉 */
    transform: translateY(100%);
    transition: transform 0.25s ease-in;
}

.py-popup-box.show {
    transform: translateY(0);
    /* 入场：弹簧上滑 */
    transition: transform var(--dur-spring, 0.45s) var(--ease-spring, cubic-bezier(0.32, 0.72, 0.28, 1.1));
}

/* grabber：iOS sheet 顶部小横条 */
.py-popup-grabber {
    width: 72rpx;
    height: 10rpx;
    border-radius: 999rpx;
    background: rgba(15, 23, 42, 0.18);
    margin: 14rpx auto 6rpx;
    flex-shrink: 0;
}

.py-popup-title {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    height: 88rpx;
    font-size: 32rpx;
    font-weight: 600;
    color: var(--c-text);
    flex-shrink: 0;
}

/* 圆形玻璃关闭 chip（替代裸 ✕） */
.py-popup-close {
    position: absolute;
    right: 24rpx;
    top: 50%;
    transform: translateY(-50%);
    width: 56rpx;
    height: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28rpx;
    font-weight: 400;
    color: var(--c-sub);
    border-radius: 50%;
    background: var(--glass-field-bg, rgba(255, 255, 255, 0.6));
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
}

.py-popup-body {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
}

.py-popup-body.no-title {
    padding-top: 8rpx;
}

.py-popup-safearea {
    height: env(safe-area-inset-bottom);
    flex-shrink: 0;
}
