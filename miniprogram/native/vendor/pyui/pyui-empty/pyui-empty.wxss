.py-empty-anim { animation: py-empty-rise 0.4s cubic-bezier(0.32, 0.72, 0.28, 1.1) both; }

@keyframes py-empty-rise {
    from { opacity: 0; transform: translateY(24rpx); }
    to { opacity: 1; transform: none; }
}

