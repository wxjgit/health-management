/* py-overlay · 玻璃设计语言全局弹层（toast/loading/modal） */

.ov-root {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none; /* 根不挡交互；各弹层自行开启 */
    z-index: 9999;
}

/* ── 遮罩 ── */
.ov-mask {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 23, 42, 0.35);
    pointer-events: auto;
    animation: ov-fade 0.2s ease both;
}

.ov-mask-blur {
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
}

/* ── toast：暗玻璃胶囊 ── */
.ov-toast {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16rpx;
    max-width: 480rpx;
    padding: 32rpx 40rpx;
    border-radius: 24rpx;
    background: rgba(15, 23, 42, 0.78);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.28),
                inset 0 0 0 1rpx rgba(255, 255, 255, 0.14);
    pointer-events: auto;
    animation: ov-pop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.ov-toast-text-only {
    padding: 24rpx 40rpx;
}

.ov-toast-text {
    font-size: 28rpx;
    color: #ffffff;
    text-align: center;
    line-height: 1.5;
}

/* ✓ / ✕ 纯 CSS glyph */
/* glyph 用 base64 SVG background：居中由 background-position 保证，免手摆坐标 */
.ov-glyph {
    animation: py-ov-glyph-pop 0.35s var(--ease-spring, cubic-bezier(0.32, 0.72, 0.28, 1.1)) both;
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 62% 62%;
}

