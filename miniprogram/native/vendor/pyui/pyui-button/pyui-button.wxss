/* py-button — Liquid Glass 玻璃 pill（批次 G0）
   JS 生成的内联 btnStyle（实心底/文字色）与内联 radius 由本配方 !important 统一接管；
   width/height/font-size 内联传参保持生效。 */

.py-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 24rpx;
    margin: 0;
    line-height: 1.2;
    box-sizing: border-box;
    white-space: nowrap;
    /* 亮斑绝对定位的参照 + 裁切亮斑出界（iOS 高光也裁在控件内） */
    position: relative;
    overflow: hidden;
    /* 松手回弹：弹簧贝塞尔（与 --ease-spring 同源）；按下态单独声明快收曲线 */
    transition: opacity 0.15s,
        background 0.3s cubic-bezier(0.32, 0.72, 0.28, 1.1),
        transform 0.45s cubic-bezier(0.32, 0.72, 0.28, 1.1);
    /* 玻璃 pill 基础配方：白玻璃底 + blur sm + 白描边 + 折射环 + 全圆角 */
    background: rgba(255, 255, 255, 0.5);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    backdrop-filter: var(--glass-blur-sm);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--r-full);
    box-shadow: var(--glass-ring);
    color: var(--fui-color-primary, #015293);
    font-weight: 600;
}

.py-btn-ring {
    width: 30rpx;
    height: 30rpx;
    border-radius: 50%;
    margin-right: 12rpx;
    background: conic-gradient(from 0deg, rgba(60, 60, 67, 0) 0%, currentColor 100%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4rpx), #000 calc(100% - 3rpx));
    mask: radial-gradient(farthest-side, transparent calc(100% - 4rpx), #000 calc(100% - 3rpx));
    animation: py-btn-spin 0.9s linear infinite;
    opacity: 0.8;
}

@keyframes py-btn-spin {
    to { transform: rotate(360deg); }
}

.py-btn::after {
    border: none;
}

/* plain：更透的玻璃底（.3），默认 primary 30% 描边；
   语义色描边由后置的 tint 规则覆盖（源码顺序即优先级） */
.is-plain {
    border-color: rgba(1, 82, 147, 0.3);
}

.py-btn.is-plain {
    background: rgba(255, 255, 255, 0.6);
}

/* type 语义色 → 玻璃 tint：同色 12% 透明底 + 同色文字 + 同色 30% 描边 */
.py-btn-success {
    background: rgba(9, 190, 79, 0.12);
    border-color: rgba(9, 190, 79, 0.3);
    color: var(--fui-color-success, #09BE4F);
}

.py-btn-warning {
    background: rgba(255, 183, 3, 0.12);
    border-color: rgba(255, 183, 3, 0.3);
    color: var(--fui-color-warning, #FFB703);
}

.py-btn-danger {
    background: rgba(255, 43, 43, 0.12);
    border-color: rgba(255, 43, 43, 0.3);
    color: var(--fui-color-danger, #FF2B2B);
}

.py-btn-purple {
    background: rgba(104, 49, 255, 0.12);
    border-color: rgba(104, 49, 255, 0.3);
    color: var(--fui-color-purple, #6831FF);
}

/* white：更白的高透玻璃 + 主文字色 */
.py-btn-white {
    background: var(--glass-card-bg);
    color: var(--c-text);
}

/* none：全透明无玻璃（保持原白字语义） */
.py-btn-none {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    color: #FFFFFF;
}

.py-btn.bold {
    font-weight: bold;
}

.py-btn.disabled {
    opacity: 0.5;
}

/* 首帧零延时放大：纯渲染层伪类，覆盖逻辑层 pressing class 到达前约 30ms；
   置于 hover 规则之前，保证亮斑态接管后同源覆盖 */
.py-btn:active {
    transform: scale(var(--press-scale, 1.04));
}

/* 按压透镜亮斑：pressing 态 class 由 js 自管（不依赖原生 hover-class）；
   落点亮斑经 --press-x/y 内联变量定位，跟手由 index.wxs 渲染层 inline 覆写 */
/* 手指亮斑节点：transform 定位走合成器通道（tab-bar 透镜同款跟手原理）；
   background-image 渐变逐帧重绘是卡顿根因，弃 */
.py-btn-spot {
    position: absolute;
    left: 0;
    top: 0;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(circle,
        rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.55) 45%, rgba(255, 255, 255, 0) 72%);
    pointer-events: none;
    will-change: transform;
}

.py-btn.py-btn-hover {
    /* 不动底色、不整面提亮（白玻璃底上全局提白会吞掉亮斑，用户实测根因）；
       白底感知靠外隆起阴影 + 玻璃增厚 */
    box-shadow: var(--glass-ring), 0 6px 18px rgba(15, 23, 42, 0.12);
    -webkit-backdrop-filter: blur(16px) saturate(220%);
    backdrop-filter: blur(16px) saturate(220%);
    /* 按压态对标 iOS 26 Liquid Glass：放大；按下 120ms 快收 */
    transform: scale(var(--press-scale, 1.04));
    transition: background 0.12s cubic-bezier(0.2, 0, 0, 1),
        transform 0.12s cubic-bezier(0.2, 0, 0, 1),
        box-shadow 0.12s cubic-bezier(0.2, 0, 0, 1);
}

.py-btn-none.py-btn-hover {
    background-image: none;   /* 全透明钮（图上白字场景）不叠亮斑 */
}
