  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 86vh;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 30rpx 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 48rpx rgba(23, 36, 61, 0.12);
