.tab-shell {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}
.tab-glass {
  position: relative;
  display: flex;
  align-items: center;
  padding: 10rpx;
  min-height: 112rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 58rpx;
  background: linear-gradient(
    105deg,
    rgba(218, 245, 231, 0.96),
    rgba(182, 229, 253, 0.96) 48%,
    rgba(251, 239, 226, 0.97)
  );
  box-shadow: 0 12rpx 56rpx rgba(76, 101, 130, 0.14);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  pointer-events: auto;
}
.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 106rpx;
  border: 2rpx solid transparent;
  border-radius: 50rpx;
  color: #7b899a;
}
.tab-indicator {
  position: absolute;
  left: 10rpx;
  top: 50%;
  margin-top: -53rpx;
  width: calc((100% - 20rpx) / 4);
  height: 106rpx;
  box-sizing: border-box;
  border-radius: 50rpx;
  background: rgba(237, 249, 255, 0.78);
  border: 2rpx solid white;
  transition: transform 220ms cubic-bezier(0.22, 0.68, 0.3, 1);
  pointer-events: none;
}
.tab-item.is-selected { color: #2854ea; }
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 7rpx;
}
.tab-label {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 23rpx;
  line-height: 30rpx;
}
.is-selected .tab-label {
  font-weight: 600;
}
